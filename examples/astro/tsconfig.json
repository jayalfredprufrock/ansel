{
  "extends": "astro/tsconfigs/strict",
  "compilerOptions": {
    // Resolve the package's `vite` types to this app's Vite, as they would for a real user.
    "paths": { "vite": ["./node_modules/vite/dist/node/index.d.ts"] }
  },
  "include": [".astro/types.d.ts", "**/*"],
  "exclude": ["dist"]
}
