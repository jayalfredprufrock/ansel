{
  "name": "@jayalfredprufrock/ansel",
  "version": "0.0.0-semantically-released",
  "description": "Responsive images for Vite, Astro and React: a typed image manifest, build-time placeholders, an <Img> component and a shared URL format for an image optimizer",
  "homepage": "https://github.com/jayalfredprufrock/ansel#readme",
  "bugs": {
    "url": "https://github.com/jayalfredprufrock/ansel/issues"
  },
  "license": "MIT",
  "author": "jayalfredprufrock",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/jayalfredprufrock/ansel.git"
  },
  "files": [
    "dist",
    "src/astro",
    "src/client.d.ts",
    "src/styles.css"
  ],
  "type": "module",
  "sideEffects": false,
  "exports": {
    ".": "./src/index.ts",
    "./url": "./src/url.ts",
    "./vite": "./src/vite.ts",
    "./react": "./src/react.tsx",
    "./Img.astro": "./src/astro/Img.astro",
    "./client": {
      "types": "./src/client.d.ts"
    },
    "./render": "./src/render.ts",
    "./styles.css": "./src/styles.css",
    "./cdk": "./src/cdk.ts",
    "./package.json": "./package.json"
  },
  "publishConfig": {
    "exports": {
      ".": {
        "types": "./dist/index.d.mts",
        "default": "./dist/index.mjs"
      },
      "./url": {
        "types": "./dist/url.d.mts",
        "default": "./dist/url.mjs"
      },
      "./vite": {
        "types": "./dist/vite.d.mts",
        "default": "./dist/vite.mjs"
      },
      "./react": {
        "types": "./dist/react.d.mts",
        "default": "./dist/react.mjs"
      },
      "./Img.astro": "./src/astro/Img.astro",
      "./client": {
        "types": "./src/client.d.ts"
      },
      "./render": {
        "types": "./dist/render.d.mts",
        "default": "./dist/render.mjs"
      },
      "./cdk": {
        "types": "./dist/cdk.d.mts",
        "default": "./dist/cdk.mjs"
      },
      "./styles.css": "./src/styles.css",
      "./package.json": "./package.json"
    },
    "access": "public"
  },
  "scripts": {
    "prepare": "vp config",
    "build": "vp pack",
    "ci": "vp check && vp test && vp pack && vp run -r check:astro && vp run -r build"
  },
  "dependencies": {
    "sharp": "^0.35.5"
  },
  "devDependencies": {
    "@aws-sdk/client-s3": "^3.1175.0",
    "@semantic-release/exec": "^7.1.0",
    "@types/node": "^26.6.6",
    "@types/react": "^19.3.0",
    "aws-cdk-lib": "^2.200.0",
    "constructs": "^10.0.0",
    "conventional-changelog-conventionalcommits": "^9.3.1",
    "react": "^19.3.1",
    "semantic-release": "^25.0.9",
    "typescript": "^6.0.3",
    "vite": "catalog:",
    "vite-plus": "catalog:"
  },
  "peerDependencies": {
    "astro": "^7.0.0",
    "aws-cdk-lib": "^2.200.0",
    "constructs": "^10.0.0",
    "react": "^19.0.0",
    "vite": ">=8.0.0"
  },
  "peerDependenciesMeta": {
    "astro": {
      "optional": true
    },
    "react": {
      "optional": true
    },
    "vite": {
      "optional": true
    },
    "aws-cdk-lib": {
      "optional": true
    },
    "constructs": {
      "optional": true
    }
  },
  "release": {
    "branches": [
      "main"
    ],
    "tagFormat": "v${version}",
    "plugins": [
      [
        "@semantic-release/commit-analyzer",
        {
          "preset": "conventionalcommits",
          "releaseRules": [
            {
              "breaking": true,
              "release": "minor"
            },
            {
              "type": "feat",
              "release": "minor"
            },
            {
              "release": "patch"
            }
          ]
        }
      ],
      [
        "@semantic-release/release-notes-generator",
        {
          "preset": "conventionalcommits",
          "presetConfig": {
            "types": [
              {
                "type": "feat",
                "section": "Features"
              },
              {
                "type": "fix",
                "section": "Bug Fixes"
              },
              {
                "type": "perf",
                "section": "Performance"
              },
              {
                "type": "revert",
                "section": "Reverts"
              },
              {
                "type": "refactor",
                "section": "Refactoring"
              },
              {
                "type": "docs",
                "section": "Docs"
              },
              {
                "type": "style",
                "section": "Other"
              },
              {
                "type": "build",
                "section": "Other"
              },
              {
                "type": "ci",
                "section": "Other"
              },
              {
                "type": "test",
                "section": "Other"
              },
              {
                "type": "chore",
                "section": "Other"
              }
            ]
          }
        }
      ],
      [
        "@semantic-release/exec",
        {
          "prepareCmd": "npm pkg set version=${nextRelease.version}",
          "publishCmd": "pnpm publish --no-git-checks"
        }
      ],
      "@semantic-release/github"
    ]
  },
  "engines": {
    "node": ">=22.18"
  },
  "packageManager": "pnpm@12.18.0"
}
